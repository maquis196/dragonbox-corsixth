FROM arm32v7/debian:12

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        libsdl2-dev \
	ca-certificates \
        cmake \
        wget \
	g++ \
	fluid \ 
        squashfs-tools \
        zip \
	pkg-config \
	libssl-dev \
        libcurl4-nss-dev \
	ffmpeg \
	libavcodec-dev \
	libavformat-dev \
	libavdevice-dev \
	libavutil-dev \
	libavfilter-dev \
	libswscale-dev \
	libpostproc-dev \
	libswresample-dev
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

CMD ["/bin/bash"]
